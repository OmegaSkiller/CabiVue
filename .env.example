APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
PORT=3210
SECURE_COOKIES=false
# Set only the trusted reverse proxy's IP/CIDR for HTTPS deployments.
TRUST_PROXY=
BOOTSTRAP_SECRET_FILE=./secrets/bootstrap

# Compose uses this separately from the development origin above.
CABIVUE_PUBLIC_ORIGIN=http://localhost:3210
