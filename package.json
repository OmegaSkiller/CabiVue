{
  "name": "cabivue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your home medicine cabinet, clearly organized.",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx scripts/demo.ts",
    "setup": "tsx scripts/setup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tabler/icons-react": "3.49.0",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "openai": "7.28.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "daisyui": "5.7.47",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
